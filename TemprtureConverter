temperature = float(input("Enter temperature: "))
choice = input("Convert to (C/F): ").lower()

if choice == "f":
    result = (temperature * 9/5) + 32
    print("Fahrenheit:", result)

elif choice == "c":
    result = (temperature - 32) * 5/9
    print("Celsius:", result)

else:
    print("Invalid choice")