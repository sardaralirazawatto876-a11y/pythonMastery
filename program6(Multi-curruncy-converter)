import requests

amount = float(input("Enter amount: "))

base = input("Convert FROM (e.g. USD): ").upper()

target = input("Convert TO (e.g. PKR): ").upper()

url = f"https://api.frankfurter.dev/v2/rate/{base}/{target}"

response = requests.get(url)

data = response.json()

rate = data["rate"]

converted = amount * rate

print("--------------------------")
print("Exchange Rate:", rate)
print("Converted Amount:", round(converted, 2), target)
print("--------------------------")